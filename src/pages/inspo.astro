---
import Layout from "@/layouts/Layout.astro";
import { inspo } from "@/data/inspo";
---

<Layout title="inspo" description="developers and sites that inspired me">
  <section class="pt-16">
    <div class="space-y-2 mb-stack">
      <h1>inspo</h1>
      <p class="text-muted">developers and sites that inspired me.</p>
    </div>

    <ul class="space-y-2">
      {
        inspo.map((person) => (
          <li>
            <a href={person.url} target="_blank" rel="noopener noreferrer">
              {person.name}
              <span class="sr-only">(opens in new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a href="/" class="inline-block whitespace-nowrap mt-stack">back to home</a>
  </section>
</Layout>
