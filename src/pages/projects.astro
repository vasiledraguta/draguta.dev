---
import Layout from "@/layouts/Layout.astro";
import ProjectList from "@/components/ProjectList";
import { projects } from "@/data/projects";

const projectImages = projects
  .map((p) => p.image)
  .filter((image): image is string => typeof image === "string");
---

<Layout
  title="projects"
  description="things I have built"
  wide
  preloadImages={projectImages}
>
  <section class="pt-16">
    <div class="space-y-2 mb-block">
      <h1>projects</h1>
      <p class="text-muted">things i've built and worked on.</p>
    </div>

    <ProjectList client:load projects={projects} />

    <a
      href="/"
      class="text-foreground inline-block whitespace-nowrap mt-block underline hover:text-muted transition-colors"
      >back to home</a
    >
  </section>
</Layout>
