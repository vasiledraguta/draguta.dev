---
import Layout from "@/layouts/Layout.astro";
import { setup } from "@/data/setup";
---

<Layout title="setup" description="hardware and software i use daily">
  <section class="pt-16">
    <div class="space-y-2 mb-stack">
      <h1>setup</h1>
      <p class="text-muted">hardware and software i use daily.</p>
    </div>

    <div class="space-y-stack">
      {
        setup.map((category) => (
          <div>
            <h2 class="mb-3">{category.title}</h2>
            <ul class="space-y-2">
              {category.items.map((item) => (
                <li class="flex items-baseline justify-between gap-4">
                  <div>
                    {item.link ? (
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.name}
                        <span class="sr-only">(opens in new tab)</span>
                      </a>
                    ) : (
                      <span class="text-muted">{item.name}</span>
                    )}
                  </div>
                  {item.description && (
                    <span class="text-muted">{item.description}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <a href="/" class="inline-block whitespace-nowrap mt-stack">back to home</a>
  </section>
</Layout>
