---
import Layout from "@/layouts/Layout.astro";
import { setup } from "@/data/setup";

const linkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline ml-1 opacity-40"><path d="M10 14a4 4 0 0 0 5.66 0l3-3A4 4 0 0 0 13 5.34l-1.5 1.5"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3A4 4 0 0 0 11 18.66l1.5-1.5"/></svg>`;
---

<Layout title="setup" description="hardware and software i use daily">
  <section class="pt-16">
    <div class="space-y-2 mb-block">
      <h1>setup</h1>
      <p class="text-muted">hardware and software i use daily.</p>
    </div>

    <div class="space-y-block">
      {
        setup.map((category) => (
          <div>
            <h2 class="mb-3">{category.title}</h2>
            <ul class="space-y-2">
              {category.items.map((item) => (
                <li class="flex items-baseline justify-between gap-4">
                  <div>
                    {item.link ? (
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.name}
                        <Fragment set:html={linkIcon} />
                        <span class="sr-only">(opens in new tab)</span>
                      </a>
                    ) : (
                      <span class="text-muted">{item.name}</span>
                    )}
                  </div>
                  {item.description && (
                    <span class="text-muted">{item.description}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <a href="/" class="inline-block whitespace-nowrap mt-block">back to home</a>
  </section>
</Layout>
