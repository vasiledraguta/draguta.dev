---
import Layout from "@/layouts/Layout.astro";
import { credits } from "@/data/credits";

const linkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline ml-1 opacity-40"><path d="M10 14a4 4 0 0 0 5.66 0l3-3A4 4 0 0 0 13 5.34l-1.5 1.5"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3A4 4 0 0 0 11 18.66l1.5-1.5"/></svg>`;
---

<Layout title="credits" description="developers and sites that inspired me">
  <section class="pt-16">
    <div class="space-y-2 mb-stack">
      <h1>credits</h1>
      <p class="text-muted">developers and sites that inspired me.</p>
    </div>

    <ul class="space-y-2">
      {
        credits.map((credit) => (
          <li>
            <a href={credit.url} target="_blank" rel="noopener noreferrer">
              {credit.name}
              <Fragment set:html={linkIcon} />
              <span class="sr-only">(opens in new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a href="/" class="inline-block whitespace-nowrap mt-stack">back to home</a>
  </section>
</Layout>
