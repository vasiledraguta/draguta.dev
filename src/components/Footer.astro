---
import Shortcuts from "@/components/Shortcuts";

const currentYear = new Date().getFullYear();
---

<footer
  class="py-8 mt-auto flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
>
  <div class="flex flex-wrap items-center gap-3 text-muted">
    <p class="font-mono">© {currentYear} draguta</p>
    <span class="opacity-40 pointer-events-none" aria-hidden="true">·</span>
    <a href="/inspo">inspo</a>
  </div>
  <Shortcuts client:load />
</footer>
