---
import KeyShortcuts from "@/components/KeyShortcuts";

const currentYear = new Date().getFullYear();
---

<footer
  class="py-8 mt-auto flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
>
  <div class="flex flex-wrap items-center gap-3 text-muted">
    <p class="font-mono">© {currentYear} draguta</p>
    <span class="opacity-40 pointer-events-none" aria-hidden="true">·</span>
    <a href="/credits/">credits</a>
    <span class="opacity-40 pointer-events-none" aria-hidden="true">·</span>
    <a
      href="https://github.com/vasiledraguta/draguta.dev"
      target="_blank"
      rel="noopener noreferrer"
      >source<span class="sr-only"> (opens in new tab)</span></a
    >
  </div>
  <KeyShortcuts client:load />
</footer>
